#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference :require

layout(local_size_x = 32) in;
layout(triangles, max_vertices = 64, max_primitives = 124) out;

struct TaskPayload {
    uint visibleMeshletIndices[32];
    uint gl_DrawID;
};

taskPayloadSharedEXT TaskPayload payload;

struct Vertex {
    vec3 pos;
    vec3 normal;
    vec3 tangent;
    vec2 uv;
    float padding;
};

struct Meshlet {
    uint vertexOffset;
    uint primitiveOffset;
    uint vertexCount;
    uint primitiveCount;
};

struct MetaData {
    uint texIndex;
    uint samplerIndex;
    uint meshletCount;
    uint meshletOffset;
};

layout(set = 1, binding = 0) uniform UniformBufferObject {
    mat4 view;
    mat4 proj;
    vec3 cameraPos;
} ubo;

layout(buffer_reference) readonly buffer MeshletBuffer {
    Meshlet meshlets[]; 
};

layout(buffer_reference) readonly buffer VertexBuffer {
    Vertex vertices[]; 
};

layout(buffer_reference) readonly buffer MeshletVertices {
    uint meshletVertices[]; 
};

layout(buffer_reference) readonly buffer MeshletIndices {
    uint8_t meshletIndices[]; 
};

layout(buffer_reference) readonly buffer MetaDataBuffer {
    MetaData metadatas[];
};

layout(push_constant) uniform PushConstants {
    MeshletBuffer meshletBuffer;
    VertexBuffer vertexBuffer;
    MeshletVertices meshletVertices;
    MeshletIndices meshletIndices;
    MetaDataBuffer metadataBuffer;
} pc;

layout(location = 0) out vec2 uv[];
layout(location = 1) flat out uint texIndex[];
layout(location = 2) flat out uint samplerIndex[];
layout(location = 3) out vec3 view[];

void main() {
    uint mi = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;

    uint mii = payload.visibleMeshletIndices[mi];
    Meshlet m = pc.meshletBuffer.meshlets[mii];
    uint v_count = m.vertexCount;
    uint p_count = m.primitiveCount;

    SetMeshOutputsEXT(v_count, p_count);

    for(uint i = tid;i < v_count;i += 32) {
        uint vertexIdx = pc.meshletVertices.meshletVertices[m.vertexOffset + i];
        vec3 pos = pc.vertexBuffer.vertices[vertexIdx].pos;

        vec4 f_pos = ubo.proj * ubo.view * vec4(pos, 1.0);

        vec3 v = normalize(ubo.cameraPos - f_pos.xyz);
        vec3 n = normalize(pc.vertexBuffer.vertices[vertexIdx].normal);
        vec3 t = normalize(pc.vertexBuffer.vertices[vertexIdx].tangent);
        vec3 b = normalize(cross(t, n));

        view[i] = normalize(mat3(t, b, n) * v);

        gl_MeshVerticesEXT[i].gl_Position = f_pos;

        uv[i] = pc.vertexBuffer.vertices[vertexIdx].uv;
        texIndex[i] = pc.metadataBuffer.metadatas[payload.gl_DrawID].texIndex;
        samplerIndex[i] = pc.metadataBuffer.metadatas[payload.gl_DrawID].samplerIndex;
        
    }

    for (uint i = tid; i < p_count; i += 32) {
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(
            pc.meshletIndices.meshletIndices[m.primitiveOffset + i * 3 + 0],
            pc.meshletIndices.meshletIndices[m.primitiveOffset + i * 3 + 1],
            pc.meshletIndices.meshletIndices[m.primitiveOffset + i * 3 + 2]
        );
    }
}
