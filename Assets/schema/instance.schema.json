{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene.schema.json",
  "title": "Scene Instance Config",
  "type": "object",
  "additionalProperties": false,
  "description": "A list of placed objects (instances), each optionally targeting a render pass. Fields pos/scale/rotation are numeric vectors, textures is a string array, model is an optional string.",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pass": {
            "type": "string"
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "scale": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "textures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "pass",
          "pos",
          "scale",
          "rotation",
          "textures"
        ]
      }
    }
  }
}
