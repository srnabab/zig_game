{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layout.schema.json",
  "title": "Layout Config",
  "type": "object",
  "additionalProperties": false,
  "description": "A list of placements. Each entry references an rdata entry by name and gives its transform (pos/scale/rotation, 3 numbers each).",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "scale": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": ["name", "pos", "scale", "rotation"]
      }
    }
  },
  "required": ["items"]
}
